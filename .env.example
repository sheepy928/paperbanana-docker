# =============================================================================
# PaperBanana Docker — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# At minimum, set one API key for the model provider you intend to use.
# =============================================================================

# --- API Keys (set at least one) -------------------------------------------

GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# --- Model Selection -------------------------------------------------------
# Defaults are set for Gemini. Override to use a different provider.

MAIN_MODEL_NAME=gemini-3.1-pro-preview
IMAGE_GEN_MODEL_NAME=gemini-3.1-flash-image-preview

# --- Cloudflared Tunnel (optional) -----------------------------------------
# Set to "true" to start a cloudflared quick tunnel for public HTTPS access.

ENABLE_CLOUDFLARED=false

# --- Streamlit Port --------------------------------------------------------
# Change if 8080 conflicts with another service.

STREAMLIT_PORT=8080
